<?xml version="1.0" encoding="utf-8"?>
<!--
  App Installer template. tools/build-release.ps1 fills {Version}, {Publisher}, {AppInstallerUri} and {MsixUri}.
  The file names carry no version, so the GitHub "latest release" download URLs never change and
  every installed copy finds the next version at the same address.
-->
<AppInstaller
  xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
  Uri="{AppInstallerUri}"
  Version="{Version}">

  <MainPackage
    Name="johnovanni.EarthWatch3D"
    Publisher="{Publisher}"
    Version="{Version}"
    ProcessorArchitecture="x64"
    Uri="{MsixUri}" />

  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="24" ShowPrompt="true" UpdateBlocksActivation="false" />
    <AutomaticBackgroundTask />
  </UpdateSettings>
</AppInstaller>
