<Window x:Class="EarthWatch3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:views="clr-namespace:EarthWatch3D.App.Views"
        Title="EarthWatch3D" Height="720" Width="1100" Background="#04060E">
    <!-- The globe, markers, overlay and camera input are wired by Controllers/SceneController. -->
    <Grid x:Name="Root">
        <!-- Left-drag rotates. Helix's other default gestures are switched off: they swap in an orthographic camera
             (Ctrl+Shift+O), move the orbit centre off the Earth (pan, change look-at, WASD move, zoom rectangle),
             jump to fixed views (Ctrl+F/B/L/R/U/D) or change the field of view. Home, double-click and the wheel are
             the app's own (SceneController); its Home replaces zoom-extents and reset-camera. -->
        <helix:HelixViewport3D x:Name="Viewport" Background="#04060E"
                               CameraRotationMode="Turntable" ModelUpDirection="0,0,1"
                               ShowViewCube="False" ShowCoordinateSystem="False" ZoomAroundMouseDownPoint="False"
                               IsHeadLightEnabled="False" ShowFrameRate="False"
                               RotateGesture="LeftClick" RotateGesture2="{x:Null}"
                               IsPanEnabled="False" PanGesture="{x:Null}" PanGesture2="{x:Null}"
                               IsMoveEnabled="False" IsChangeFieldOfViewEnabled="False" ChangeFieldOfViewGesture="{x:Null}"
                               ChangeLookAtGesture="{x:Null}" ZoomRectangleGesture="{x:Null}" ZoomExtentsGesture="{x:Null}"
                               OrthographicToggleGesture="{x:Null}"
                               ResetCameraGesture="{x:Null}" ResetCameraKeyGesture="{x:Null}"
                               FrontViewGesture="{x:Null}" BackViewGesture="{x:Null}" LeftViewGesture="{x:Null}"
                               RightViewGesture="{x:Null}" TopViewGesture="{x:Null}" BottomViewGesture="{x:Null}">
            <helix:HelixViewport3D.Camera>
                <PerspectiveCamera Position="0,-3,1" LookDirection="0,3,-1" UpDirection="0,0,1" FieldOfView="45"
                                   NearPlaneDistance="0.01" FarPlaneDistance="100"/>
            </helix:HelixViewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <AmbientLight Color="White"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </helix:HelixViewport3D>
        <views:SunMoonCard x:Name="Card" DataContext="{Binding SunMoon}"/>
        <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
    </Grid>
</Window>
