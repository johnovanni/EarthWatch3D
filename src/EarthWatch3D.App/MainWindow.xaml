<Window x:Class="EarthWatch3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="EarthWatch3D" Height="720" Width="1100" Background="#04060E"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <helix:HelixViewport3D x:Name="Viewport" Background="#04060E"
                               CameraRotationMode="Turntable" ModelUpDirection="0,0,1"
                               ShowViewCube="False" ShowCoordinateSystem="False" ZoomAroundMouseDownPoint="False"
                               IsPanEnabled="False" IsHeadLightEnabled="False" ShowFrameRate="False"
                               CameraChanged="OnCameraChanged"
                               PreviewMouseWheel="OnPreviewMouseWheel"
                               PreviewMouseDown="OnPreviewMouseDown">
            <helix:HelixViewport3D.Camera>
                <PerspectiveCamera Position="0,-3,1" LookDirection="0,3,-1" UpDirection="0,0,1" FieldOfView="45"
                                   NearPlaneDistance="0.01" FarPlaneDistance="100"/>
            </helix:HelixViewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <AmbientLight Color="White"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="GlobeVisual"/>
        </helix:HelixViewport3D>
        <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
    </Grid>
</Window>
