<Window x:Class="EarthWatch3D.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About EarthWatch3D" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#101624">
    <!-- DataContext: AboutViewModel. A small dialog in the cards' dark style. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="#C8CDD8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,16,0,6"/>
            </Style>
            <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="#C8CDD8"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="#7FB6FF"/>
            </Style>
            <!-- Implicit TextBlock styles do not reach into a DataTemplate's own content, so the colours are set here. -->
            <DataTemplate x:Key="CreditTemplate">
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Foreground="White" FontSize="13" FontWeight="Bold">
                        <Hyperlink Foreground="#7FB6FF" Click="Link_Click" ToolTip="{Binding Url}"><Run Text="{Binding Name, Mode=OneWay}"/></Hyperlink>
                    </TextBlock>
                    <TextBlock Foreground="#C8CDD8" FontSize="12" TextWrapping="Wrap" Text="{Binding Text}"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="LicenceTemplate">
                <TextBlock Foreground="White" FontSize="13" Margin="0,0,0,3">
                    <Hyperlink Foreground="#7FB6FF" Click="Link_Click" ToolTip="{Binding Url}"><Run Text="{Binding Name, Mode=OneWay}"/></Hyperlink><Run Foreground="#C8CDD8" Text=": "/><Run Foreground="#C8CDD8" Text="{Binding Text, Mode=OneWay}"/>
                </TextBlock>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The Grid has no margin of its own, so the snapshot (which sizes itself from the content) covers the margins too. -->
    <Grid>
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="EarthWatch3D" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Version}" Foreground="#C8CDD8" Margin="0,2,0,8"/>
        <TextBlock Text="Live earthquakes, storms and lightning on a 3D globe."/>
        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                   Text="Shown for interest, not for safety decisions: follow your local weather service and authorities."/>

        <TextBlock Style="{StaticResource Heading}" Text="Data and imagery"/>
        <ItemsControl ItemsSource="{Binding Credits}" ItemTemplate="{StaticResource CreditTemplate}"/>

        <TextBlock Style="{StaticResource Heading}" Text="Software libraries"/>
        <ItemsControl ItemsSource="{Binding Licences}" ItemTemplate="{StaticResource LicenceTemplate}"/>

        <TextBlock Foreground="#FFB4A8" Margin="0,10,0,0" Text="{Binding Message}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}" Content="Open" Padding="14,4" Margin="10,0,0,0"
                    Command="{Binding OpenDataFolderCommand}"/>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Note}">
                <Run Text="Data and logs: "/><Run Text="{Binding DataFolder, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}" Content="Close" Padding="18,4" IsCancel="True" IsDefault="True"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource CardButton}" Content="Licence texts" Padding="14,4"
                    Command="{Binding OpenNoticesCommand}"/>
        </DockPanel>
    </StackPanel>
    </Grid>
</Window>
