<UserControl x:Class="EarthWatch3D.App.Views.StatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EarthWatch3D.App.Views">
    <!-- DataContext: StatusViewModel. One dot per data source; the tooltip gives the last update and error. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ItemsControl x:Name="Dots" ItemsSource="{Binding Items}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- A transparent cell around each dot makes the tooltip easy to hit. -->
                <Border Background="Transparent" Padding="3,6" ToolTip="{Binding Tooltip}"
                        ToolTipService.InitialShowDelay="200" MouseLeftButtonUp="Dot_Click">
                    <Ellipse Width="10" Height="10"
                             Fill="{Binding State, Converter={x:Static local:FeedStateBrushConverter.Instance}}"/>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
