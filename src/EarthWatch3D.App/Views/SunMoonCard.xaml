<UserControl x:Class="EarthWatch3D.App.Views.SunMoonCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EarthWatch3D.App.Views"
             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <!-- Must follow the implicit style it is based on (a StaticResource only sees what is above it). -->
            <!-- Each icon gets a fixed-width slot: the ☀ and ☾ glyphs differ in width, and ☾ draws past its own edge. -->
            <Style x:Key="Icon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Width" Value="18"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="#CC101624" CornerRadius="8" Padding="12,8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="230"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                        <Setter Property="Width" Value="Auto"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}" Padding="6,0"
                        Command="{Binding ToggleCollapsedCommand}" ToolTip="Collapse / expand"
                        Content="{Binding IsCollapsed, Converter={x:Static local:ChevronConverter.Instance}}"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsCollapsed, Converter={StaticResource B2V}}">
                    <TextBlock Style="{StaticResource Icon}" Text="☀"/>
                    <TextBlock Style="{StaticResource Icon}" Text="☾" Margin="6,0,10,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="Sun &amp; Moon" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
            <StackPanel Margin="0,6,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Icon}" HorizontalAlignment="Left" Text="☀"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubSolarText}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="0,2,0,0" Text="☾"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Text="{Binding SubLunarText}"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="0,2,0,0" Text="☀"
                               ToolTip="{Binding SunDistanceToolTip}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2,0,0" ToolTip="{Binding SunDistanceToolTip}"><Run Text="distance "/><Run Text="{Binding SunDistanceText, Mode=OneWay}"/></TextBlock>
                    <TextBlock Grid.Row="3" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="0,2,0,0" Text="☾"
                               ToolTip="{Binding MoonDistanceToolTip}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2,0,0" ToolTip="{Binding MoonDistanceToolTip}"><Run Text="distance "/><Run Text="{Binding MoonDistanceText, Mode=OneWay}"/></TextBlock>
                </Grid>
                <TextBlock Margin="0,2,0,0">
                    <Run Text="{Binding MoonIlluminatedPercent, Mode=OneWay}"/><Run Text="% lit, "/><Run Text="{Binding MoonWaxing, Mode=OneWay, Converter={x:Static local:PhaseConverter.Instance}}"/>
                </TextBlock>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Face Sun" Style="{StaticResource CardButton}" Command="{Binding FaceSunCommand}"/>
                    <Button Grid.Column="2" Content="Face Moon" Style="{StaticResource CardButton}" Command="{Binding FaceMoonCommand}"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
