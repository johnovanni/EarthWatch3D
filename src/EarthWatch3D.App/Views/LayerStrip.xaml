<UserControl x:Class="EarthWatch3D.App.Views.LayerStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EarthWatch3D.App.Views"
             xmlns:rendering="clr-namespace:EarthWatch3D.App.Rendering"
             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
    <!-- DataContext: MainViewModel (Layers for the toggles, Display for the flyout). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Icon toggle: the icon is the Tag, the label (shown when the strip is expanded) the Content. -->
            <Style x:Key="LayerButton" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                <Setter Property="ToolTipService.Placement" Value="Right"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,0" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" Width="26" FontSize="17"
                                               TextAlignment="Center"/>
                                    <ContentPresenter x:Name="Label" Margin="6,0,6,0" VerticalAlignment="Center"
                                                      TextElement.Foreground="White"
                                                      Visibility="{Binding DataContext.Layers.IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2E3A52"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Icon" Property="Opacity" Value="0.4"/>
                                    <Setter TargetName="Label" Property="Opacity" Value="0.55"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A4866"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- ≡ and ⋯ are commands, not layers: no "off" dimming. -->
            <Style x:Key="StripCommandButton" TargetType="ToggleButton" BasedOn="{StaticResource LayerButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,0" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}" Width="26" FontSize="17" TextAlignment="Center"/>
                                    <ContentPresenter Margin="6,0,6,0" VerticalAlignment="Center" TextElement.Foreground="White"
                                                      Visibility="{Binding DataContext.Layers.IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A4866"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2E3A52"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Legends inside the tooltips. -->
            <Style x:Key="LegendTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="LegendNote" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9AA3B5"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <Style x:Key="Swatch" TargetType="Rectangle">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="RadiusX" Value="2"/>
                <Setter Property="RadiusY" Value="2"/>
                <Setter Property="Margin" Value="0,1,6,1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#CC101624" CornerRadius="8" Padding="4">
        <StackPanel>
            <ToggleButton Style="{StaticResource StripCommandButton}" Tag="≡" Content="Layers"
                          IsChecked="{Binding Layers.IsExpanded}" ToolTip="Show or hide the labels"/>

            <ToggleButton x:Name="QuakesButton" Style="{StaticResource LayerButton}" Tag="◉" Content="Earthquakes"
                          IsChecked="{Binding Layers.ShowQuakes}">
                <ToggleButton.ToolTip>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LegendTitle}" Text="Earthquakes (USGS)"/>
                        <TextBlock Text="Colour by age within the display window:" Foreground="#C8CDD8" Margin="0,0,0,2"/>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FF3B30"/><TextBlock Text="newest 10%"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FF9500"/><TextBlock Text="10–35%"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FFD60A"/><TextBlock Text="35–70%"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#9C8F5A"/><TextBlock Text="oldest 30%"/></StackPanel>
                        <TextBlock Style="{StaticResource LegendNote}" Text="Disc size grows with magnitude."/>
                    </StackPanel>
                </ToggleButton.ToolTip>
            </ToggleButton>

            <ToggleButton Style="{StaticResource LayerButton}" Tag="🌀" Content="Cyclones"
                          IsChecked="{Binding Layers.ShowCyclones}">
                <ToggleButton.ToolTip>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LegendTitle}" Text="Tropical cyclones (NHC, GDACS)"/>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#5EBAFF"/><TextBlock Text="Tropical depression"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#00FAF4"/><TextBlock Text="Tropical storm"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FFFFCC"/><TextBlock Text="Category 1"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FFE775"/><TextBlock Text="Category 2"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FFC140"/><TextBlock Text="Category 3"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FF8F20"/><TextBlock Text="Category 4"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FF6060"/><TextBlock Text="Category 5"/></StackPanel>
                        <TextBlock Style="{StaticResource LegendNote}" Text="Track and forecast cone in white. Wind areas:"/>
                        <StackPanel Style="{StaticResource Row}" Margin="0,2,0,0">
                            <Rectangle Style="{StaticResource Swatch}" Fill="#34C759"/><TextBlock Text="60 km/h  " />
                            <Rectangle Style="{StaticResource Swatch}" Fill="#FF9500"/><TextBlock Text="90 km/h  "/>
                            <Rectangle Style="{StaticResource Swatch}" Fill="#FF3B30"/><TextBlock Text="120+ km/h"/>
                        </StackPanel>
                    </StackPanel>
                </ToggleButton.ToolTip>
            </ToggleButton>

            <ToggleButton Style="{StaticResource LayerButton}" Tag="⚠" Content="US alerts"
                          IsChecked="{Binding Layers.ShowAlerts}">
                <ToggleButton.ToolTip>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LegendTitle}" Text="US weather alerts (NWS)"/>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FF0000"/><TextBlock Text="Tornado Warning"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FFA500"/><TextBlock Text="Severe Thunderstorm Warning"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#8B0000"/><TextBlock Text="Flash Flood Warning"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#00FF00"/><TextBlock Text="Flood Warning"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FF69B4"/><TextBlock Text="Winter Storm Warning"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#DC143C"/><TextBlock Text="Hurricane Warning"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FFFF00"/><TextBlock Text="Tornado Watch"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#A0A0A0"/><TextBlock Text="Other alerts"/></StackPanel>
                        <TextBlock Style="{StaticResource LegendNote}" Text="Choose alert types under ⋯ Display."/>
                    </StackPanel>
                </ToggleButton.ToolTip>
            </ToggleButton>

            <ToggleButton Style="{StaticResource LayerButton}" Tag="◎" Content="EONET storms"
                          IsChecked="{Binding Layers.ShowEonet}">
                <ToggleButton.ToolTip>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LegendTitle}" Text="Severe storms (NASA EONET)"/>
                        <TextBlock Text="Storms not already shown from NHC or GDACS." Foreground="#C8CDD8"/>
                        <StackPanel Style="{StaticResource Row}" Margin="0,4,0,0">
                            <Ellipse Width="10" Height="10" Fill="#00FAF4" Margin="1,1,7,1"/>
                            <TextBlock Text="latest position, coloured by category"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <Rectangle Width="12" Height="2" Fill="#A0A0A0" Margin="0,6,6,6"/>
                            <TextBlock Text="recent track"/>
                        </StackPanel>
                    </StackPanel>
                </ToggleButton.ToolTip>
            </ToggleButton>

            <ToggleButton x:Name="LightningButton" Style="{StaticResource LayerButton}" Tag="⚡" Content="Lightning"
                          IsChecked="{Binding Layers.ShowLightning}">
                <ToggleButton.ToolTip>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LegendTitle}" Text="{x:Static rendering:LightningLayer.LegendTitle}"/>
                        <TextBlock Text="Colour by age within the display window:" Foreground="#C8CDD8" Margin="0,0,0,2"/>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FFF0B0"/><TextBlock Text="newest 10%"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FFD84A"/><TextBlock Text="10–35%"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#FF9A2E"/><TextBlock Text="35–70%"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Style="{StaticResource Swatch}" Fill="#B4602A"/><TextBlock Text="oldest 30%"/></StackPanel>
                        <TextBlock Style="{StaticResource LegendNote}" Text="{Binding Layers.LightningLegend}"/>
                        <TextBlock Style="{StaticResource LegendNote}" Text="{x:Static rendering:LightningLayer.Attribution}"/>
                        <TextBlock Style="{StaticResource LegendNote}" Text="Live only: hidden in replay. Choose the window under ⋯ Display."/>
                    </StackPanel>
                </ToggleButton.ToolTip>
            </ToggleButton>

            <ToggleButton Style="{StaticResource LayerButton}" Tag="☁" Content="Clouds"
                          IsChecked="{Binding Layers.ShowClouds}">
                <ToggleButton.ToolTip>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LegendTitle}" Text="Clouds (NASA GIBS, VIIRS)"/>
                        <TextBlock Text="One true-colour satellite image of the previous day." Foreground="#C8CDD8"/>
                        <TextBlock Style="{StaticResource LegendNote}" Text="{Binding Layers.CloudsLegend}"/>
                        <TextBlock Style="{StaticResource LegendNote}" Text="Not live and unchanged in replay. Off by default: about 2 MB a day, more while the day's image is not complete yet (it is then fetched again each hour)."/>
                    </StackPanel>
                </ToggleButton.ToolTip>
            </ToggleButton>

            <ToggleButton Style="{StaticResource LayerButton}" Tag="〰" Content="Coastlines"
                          IsChecked="{Binding Layers.ShowCoastlines}">
                <ToggleButton.ToolTip>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LegendTitle}" Text="Coastlines and borders"/>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Width="12" Height="2" Fill="#99FFFFFF" Margin="0,6,6,6"/><TextBlock Text="coastlines"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Width="12" Height="2" Fill="#66D3D3D3" Margin="0,6,6,6"/><TextBlock Text="country borders"/></StackPanel>
                        <TextBlock Style="{StaticResource LegendNote}" Text="Natural Earth 1:50m."/>
                    </StackPanel>
                </ToggleButton.ToolTip>
            </ToggleButton>

            <ToggleButton Style="{StaticResource LayerButton}" Tag="⛰" Content="Plates"
                          IsChecked="{Binding Layers.ShowPlates}">
                <ToggleButton.ToolTip>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LegendTitle}" Text="Plate boundaries (Bird 2003)"/>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Width="12" Height="2" Fill="#FF3030" Margin="0,6,6,6"/><TextBlock Text="Converging (subduction)"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Width="12" Height="2" Fill="#FFE600" Margin="0,6,6,6"/><TextBlock Text="Spreading (ridges, rifts)"/></StackPanel>
                        <StackPanel Style="{StaticResource Row}"><Rectangle Width="12" Height="2" Fill="#00E5FF" Margin="0,6,6,6"/><TextBlock Text="Sliding past (transform faults)"/></StackPanel>
                        <TextBlock Style="{StaticResource LegendNote}" Text="PB2002; data by Hugo Ahlenius, Nordpil."/>
                    </StackPanel>
                </ToggleButton.ToolTip>
            </ToggleButton>

            <ToggleButton x:Name="DisplayButton" Style="{StaticResource StripCommandButton}" Tag="⋯" Content="Display ▸"
                          ToolTip="Display options"
                          IsHitTestVisible="{Binding IsOpen, ElementName=DisplayPopup, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
            <!-- Closes when you click elsewhere; the button ignores clicks while it is open so that click only closes it. -->
            <Popup x:Name="DisplayPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                   PlacementTarget="{Binding ElementName=DisplayButton}" Placement="Right" HorizontalOffset="8"
                   IsOpen="{Binding IsChecked, ElementName=DisplayButton, Mode=TwoWay}">
                <local:DisplayFlyout DataContext="{Binding Display}"/>
            </Popup>

            <!-- A command, not a toggle: Click unchecks it again. -->
            <ToggleButton Style="{StaticResource StripCommandButton}" Tag="⚙" Content="Settings"
                          ToolTip="Settings: EUMETSAT key, download limit, units"
                          Command="{Binding OpenSettingsCommand}" Click="Settings_Click"/>

            <!-- Also a command: Click unchecks it again. -->
            <ToggleButton Style="{StaticResource StripCommandButton}" Tag="ⓘ" Content="About"
                          ToolTip="About EarthWatch3D: version, credits and licences"
                          Command="{Binding OpenAboutCommand}" Click="Settings_Click"/>
        </StackPanel>
    </Border>
</UserControl>
