<UserControl x:Class="EarthWatch3D.App.Views.TimeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EarthWatch3D.App.ViewModels"
             xmlns:local="clr-namespace:EarthWatch3D.App.Views"
             Height="40" Background="#CC0A0E18">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardStyles.xaml"/>
                <ResourceDictionary Source="TimeBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="LiveButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#99FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                        <Setter Property="Background" Value="#E0245C"/>
                        <Setter Property="BorderBrush" Value="#E0245C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource BarButton}" Content="◀◀ ▾" ToolTip="Step back"
                Click="OnStepMenuClick">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="−10 min" Command="{Binding StepMinus10MinCommand}"/>
                    <MenuItem Header="−1 hour" Command="{Binding StepMinus1HourCommand}"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Button Grid.Column="1" Style="{StaticResource BarButton}" Command="{Binding TogglePlayCommand}" ToolTip="Play / pause replay">
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="▶"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Text" Value="⏸"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
        <ComboBox Grid.Column="2" x:Name="SpeedBox" Width="68" Height="26" Margin="0,0,6,0" VerticalAlignment="Center"
                  ItemsSource="{x:Static vm:TimelineViewModel.Speeds}" ItemStringFormat="{}{0}×"
                  SelectedItem="{Binding Speed, Mode=TwoWay}" ToolTip="Replay speed"/>
        <Button Grid.Column="3" Style="{StaticResource BarButton}" Content="▾ ▶▶" ToolTip="Step forward"
                Click="OnStepMenuClick">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="+10 min" Command="{Binding StepPlus10MinCommand}"/>
                    <MenuItem Header="+1 hour" Command="{Binding StepPlus1HourCommand}"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Button Grid.Column="4" Style="{StaticResource LiveButton}" Content="LIVE" Command="{Binding GoLiveCommand}"
                ToolTip="Jump back to the live view"/>

        <Grid Grid.Column="5" Margin="6,0,12,0" VerticalAlignment="Center" Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- The 6*/1* columns assume TimelineViewModel.Range is 7 days (24 h = 1/7). The slider Maximum is set in code from Range.
                 The last 24 h of the 7-day range: a lighter band behind the track. -->
            <Rectangle Grid.Column="1" Height="8" Fill="#33FFFFFF" RadiusX="3" RadiusY="3" IsHitTestVisible="False"/>
            <Slider Grid.ColumnSpan="2" x:Name="TimeSlider" Minimum="0"
                    SmallChange="60" LargeChange="3600" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                    Value="{Binding SliderSeconds, Mode=TwoWay}"/>
        </Grid>

        <TextBlock Grid.Column="6" FontFamily="Consolas" FontSize="13" MinWidth="190" Text="{Binding ReadoutText}"
                   ToolTip="{Binding LocalTimeText}" Margin="0,0,10,0"/>
        <!-- The bar's DataContext is the timeline; the dots bind to MainViewModel.Status through the window. -->
        <ContentControl Grid.Column="7" x:Name="StatusHost" VerticalAlignment="Center">
            <local:StatusStrip DataContext="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </ContentControl>
    </Grid>
</UserControl>
