<Window x:Class="EarthWatch3D.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EarthWatch3D.App.Views"
        Title="Settings" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#101624">
    <!-- DataContext: SettingsViewModel. A small modal dialog in the cards' dark style. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="#C8CDD8"/>
                <Setter Property="Margin" Value="0,12,0,4"/>
            </Style>
            <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="#9AA3B5"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#1B2438"/>
                <Setter Property="BorderBrush" Value="#3A4256"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#1B2438"/>
                <Setter Property="BorderBrush" Value="#3A4256"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="18,8,18,16">
        <TextBlock Style="{StaticResource Label}" Text="EUMETSAT consumer key (for MTG lightning over Europe and Africa)"/>
        <TextBox x:Name="KeyBox" Text="{Binding ConsumerKey, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Style="{StaticResource Label}" Text="Consumer secret"/>
        <Grid>
            <PasswordBox x:Name="SecretBox" PasswordChanged="SecretBox_PasswordChanged"/>
            <TextBlock x:Name="SecretHint" Text="(saved)" Foreground="#9AA3B5" Margin="8,0,0,0"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource CardButton}" Content="Test" Padding="14,4"
                    Command="{Binding TestCommand}"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                <Hyperlink Foreground="#7FB6FF" Click="GetKey_Click">Get a key</Hyperlink>
            </TextBlock>
            <TextBlock Margin="10,0,10,0" Text="{Binding TestStatus}" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Note}"
                   Text="The key stays on this computer, encrypted for your Windows account. Leave the secret empty to keep the saved one; clear both to turn MTG off."/>

        <TextBlock Style="{StaticResource Label}" Text="Daily download limit (MB, empty = no limit)"/>
        <TextBox Text="{Binding DailyLimitText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>

        <TextBlock Style="{StaticResource Label}" Text="Distances and speeds"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Kilometres" GroupName="Units"
                         IsChecked="{Binding UseMiles, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
            <RadioButton Content="Miles" GroupName="Units" IsChecked="{Binding UseMiles}"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#FF9F6B" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="{Binding Error}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource CardButton}" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Style="{StaticResource CardButton}" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
